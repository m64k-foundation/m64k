{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m64k.dev/schema/scalar-shift-rotate-semantics-v1.json",
  "title": "M64K v1 scalar shift and rotate semantic contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_id", "status", "encoding_status", "scope", "source_manifest", "sources", "operand_widths_bits", "count", "writeback", "operations", "condition_state", "memory", "privilege", "synchronous_exceptions", "retirement", "lineage_differences", "verification"],
  "properties": {
    "schema": {"const": "m64k.native.instruction-semantics/v1"},
    "contract_id": {"const": "M64K-v1.scalar-shift-rotate"},
    "status": {"const": "normative-draft"},
    "encoding_status": {"const": "unallocated"},
    "scope": {"const": "Scalar ASL, ASR, LSL, LSR, ROL, ROR, ROXL, and ROXR semantics independent of numeric encoding"},
    "source_manifest": {"const": {"path": "../../../references/manuals/manifest.json", "schema": "m64k.reference-manual-manifest/v2"}},
    "sources": {"const": [
      {"document_id": "MC68060UM", "section": "1.9 Instruction Set Overview, Table 1-3 Instruction Set Summary", "pages": "1-16, 1-18, and 1-19", "lineage_role": "MC68060 cut-line presence"},
      {"document_id": "M68000PRM", "section": "Integer Instructions: ASL/ASR, LSL/LSR, ROL/ROR, and ROXL/ROXR", "pages": "4-21 through 4-24, 4-113 through 4-115, and 4-160 through 4-165", "lineage_role": "delegated operation and condition-code semantics"}
    ]},
    "operand_widths_bits": {"const": [8, 16, 32, 64]},
    "count": {"const": {"source_bits": "low-6", "range": [0, 63], "shift_reduction": "none", "rotate_reduction": "modulo-operand-width", "rotate_extend_reduction": "modulo-operand-width-plus-one"}},
    "writeback": {"const": "truncate-to-operand-width-then-zero-extend-to-64"},
    "operations": {"const": [
      {"id": "ASL", "class": "arithmetic-shift", "direction": "left", "reads_x": false, "writes_x": false, "result": "unsigned(source[W-1:0] << count) modulo 2^W", "overflow": "signed(source[W-1:0]) * 2^count is outside signed-W range", "carry": "count=0:0; 1<=count<=W:source[W-count]; count>W:0"},
      {"id": "ASR", "class": "arithmetic-shift", "direction": "right", "reads_x": false, "writes_x": false, "result": "signed(source[W-1:0]) arithmetic-right-shift count modulo 2^W", "overflow": "false", "carry": "count=0:0; 1<=count<=W:source[count-1]; count>W:source[W-1]"},
      {"id": "LSL", "class": "logical-shift", "direction": "left", "reads_x": false, "writes_x": false, "result": "unsigned(source[W-1:0] << count) modulo 2^W", "overflow": "false", "carry": "count=0:0; 1<=count<=W:source[W-count]; count>W:0"},
      {"id": "LSR", "class": "logical-shift", "direction": "right", "reads_x": false, "writes_x": false, "result": "unsigned(source[W-1:0]) logical-right-shift count", "overflow": "false", "carry": "count=0:0; 1<=count<=W:source[count-1]; count>W:0"},
      {"id": "ROL", "class": "rotate", "direction": "left", "reads_x": false, "writes_x": false, "result": "rotate source[W-1:0] left by count modulo W", "overflow": "false", "carry": "count=0:0; count>0:result[0]"},
      {"id": "ROR", "class": "rotate", "direction": "right", "reads_x": false, "writes_x": false, "result": "rotate source[W-1:0] right by count modulo W", "overflow": "false", "carry": "count=0:0; count>0:result[W-1]"},
      {"id": "ROXL", "class": "rotate-extend", "direction": "left", "reads_x": true, "writes_x": true, "result": "rotate concat(source[W-1:0],X) left by count modulo (W+1); write operand from ring[W:1] and X from ring[0]", "overflow": "false", "carry": "resulting-X"},
      {"id": "ROXR", "class": "rotate-extend", "direction": "right", "reads_x": true, "writes_x": true, "result": "rotate concat(source[W-1:0],X) right by count modulo (W+1); write operand from ring[W:1] and X from ring[0]", "overflow": "false", "carry": "resulting-X"}
    ]},
    "condition_state": {"const": {"without_F": "preserve-NZCV", "with_F": {"N": "result[W-1]", "Z": "result[W-1:0] == 0", "V": "operation-overflow-rule", "C": "operation-carry-rule"}, "X": "ROXL-and-ROXR-write-resulting-X-even-without-F; all-other-operations-preserve-X", "zero_is_sticky": false}},
    "memory": {"const": "no-memory-operand-or-side-effect"},
    "privilege": {"const": "all-levels"},
    "synchronous_exceptions": {"const": []},
    "retirement": {"const": "one-register-write-plus-optional-NZCV-write-plus-optional-X-write-at-one-precise-retirement-boundary"},
    "lineage_differences": {"const": ["M64K adds native 64-bit Q width.", "M64K has no implicit memory shift or rotate form.", "M64K narrow GPR results zero-extend to 64 bits.", "M64K updates NZCV only for explicit .F forms.", "M64K ordinary arithmetic and logical shifts preserve X; only rotate-through-X operations access X."]},
    "verification": {"const": ["exhaustive-byte-values-counts-and-X", "directed-word-long-quad-boundaries", "count-zero-width-width-plus-one-and-63", "ASL-signed-overflow-boundaries", "model-to-RTL-retirement-equivalence"]}
  }
}
